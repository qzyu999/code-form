{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-form.dev/schemas/claim.schema.json",
  "title": "code-form Claim",
  "type": "object",
  "required": [
    "id",
    "statement",
    "status",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "observed",
        "inferred",
        "proposed",
        "tested",
        "proved",
        "contradicted",
        "unknown"
      ]
    },
    "scope": {
      "type": "string"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "test",
              "config",
              "command",
              "specification",
              "formal_artifact",
              "commit"
            ]
          },
          "reference": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
